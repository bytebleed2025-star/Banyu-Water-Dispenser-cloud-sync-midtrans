{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "node cloud/build.js",
  "outputDirectory": "cloud/dist",
  "redirects": [{ "source": "/", "destination": "/dashboard.html", "permanent": false }],
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/main?route=:path*" }],
  "functions": { "api/main.js": { "maxDuration": 15 } }
}
