// Copy this file to "secrets.h" (same folder) and fill it in. secrets.h is in .gitignore: never commit it.
#pragma once

// ---- Wi-Fi at the machine's location (2.4 GHz only; ESP32 cannot use 5 GHz) ----
#define WIFI_SSID "your-wifi-name"
#define WIFI_PASS "your-wifi-password"

// ---- HiveMQ Cloud (Overview page of your cluster) ----
#define MQTT_HOST "xxxxxxxxxxxxxxxx.s1.eu.hivemq.cloud"
#define MQTT_PORT 8883
#define MQTT_USER "banyu-kiosk-01"          // create under Access Management > Credentials
#define MQTT_PASS "a-long-password"

// Name of this machine. Topics become banyu/<MACHINE_ID>/cmd, /status, /event
#define MACHINE_ID "banyu-kiosk-01"

// true = skip the certificate check. OK for the first test ONLY. Before launch set false and paste the
// "ISRG Root X1" certificate (from letsencrypt.org/certificates) into MQTT_ROOT_CA below.
#define MQTT_INSECURE true
static const char MQTT_ROOT_CA[] = R"EOF(
-----BEGIN CERTIFICATE-----
paste ISRG Root X1 here
-----END CERTIFICATE-----
)EOF";

// ---- Optional: also report events straight to the website. Leave "" until the website part exists ----
#define EVENT_URL ""                        // later: "https://banyurefillstation.com/api/device/event"
#define DEVICE_TOKEN ""                     // later: same value as DEVICE_TOKEN in Vercel
